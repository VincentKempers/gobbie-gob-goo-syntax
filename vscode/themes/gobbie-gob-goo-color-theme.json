  "semanticTokenColors": {
    "variable": "#c5c8c6",
    "parameter": "#c5c8c6",
    "property": "#c5c8c6",
    "variable.defaultLibrary": "#fda1aa",
    "function": "#81a2be",
    "method": "#81a2be",
    "function.defaultLibrary": "#a4d8d1",
    "method.defaultLibrary": "#a4d8d1",
    "class": "#f0c674",
    "class.defaultLibrary": {
      "foreground": "#f0c674",
      "underline": true
    },
    "type": {
      "foreground": "#f0c674",
      "underline": true
    },
    "interface": "#f0c674",
    "enum": "#f0c674",
    "enumMember": "#ffffff",
    "typeParameter": "#f0c674",
    "namespace": "#f0c674",
    "keyword": "#969896",
    "number": "#83c6d5",
    "string": "#9ed1a0",
    "regexp": "#a4d8d1",
    "macro": "#a4d8d1",
    "selfKeyword": "#fda1aa"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f7f7f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "storage.type.class.jsdoc",
        "keyword.other.phpdoc",
        "storage.type.class.doxygen"
      ],
      "settings": {
        "foreground": "#7f7f7f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment type",
      "scope": [
        "entity.name.type.instance.jsdoc",
        "entity.name.type.instance.phpdoc"
      ],
      "settings": {
        "foreground": "#f0c674",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Doc comment variable",
      "scope": [
        "variable.other.jsdoc",
        "variable.other.phpdoc"
      ],
      "settings": {
        "foreground": "#fda1aa",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "Keyword operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ffe2a1"
      }
    },
    {
      "name": "Keyword default export",
      "scope": [
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#fda1aa"
      }
    },
    {
      "name": "Special method",
      "scope": [
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Unit",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Escape character",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#83c6d5"
      }
    },
    {
      "name": "Color",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    },
    {
      "name": "Symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.object",
        "variable.language",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#fda1aa"
      }
    },
    {
      "name": "Plain identifiers",
      "scope": [
        "variable.other.readwrite",
        "variable.other.constant",
        "variable.other.property",
        "variable.parameter",
        "variable.parameter.function",
        "meta.object-literal.key",
        "meta.definition.variable variable.other"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "variable.interpolation",
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#fc6f7d"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fda1aa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    },
    {
      "name": "Link",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#fda1aa"
      }
    },
    {
      "name": "Punctuation definition",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.variable",
        "punctuation.definition.parameters",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Heading / identity punctuation",
      "scope": [
        "punctuation.definition.heading",
        "punctuation.definition.identity"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Bold punctuation",
      "scope": [
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#f0c674",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic punctuation",
      "scope": [
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#969896",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Support class",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "name": "Support function",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    },
    {
      "name": "Method",
      "scope": [
        "support.function.any-method",
        "meta.function-call entity.name.function",
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "new.expr entity.name.type",
        "meta.function-call support.class",
        "new.expr support.class"
      ],
      "settings": {
        "foreground": "#f0c674",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#f0c674",
        "fontStyle": ""
      }
    },
    {
      "name": "Inherited class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Section",
      "scope": [
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#fda1aa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Attribute name",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Attribute id",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "CSS class selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "name": "CSS pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Meta class",
      "scope": [
        "meta.class"
      ],
      "settings": {
        "foreground": "#f0c674"
      }
    },
    {
      "name": "Meta link",
      "scope": [
        "meta.link"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Meta require",
      "scope": [
        "meta.require"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Meta selector",
      "scope": [
        "meta.selector"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "Meta separator",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "None",
      "scope": [
        "none",
        "source",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#c5c8c6"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#969896",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#969896"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#fda1aa"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Markup heading punctuation",
      "scope": [
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#81a2be"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#fda1aa"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Markup raw",
      "scope": [
        "markup.raw.inline",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9ed1a0"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#a4d8d1"
      }
    }
  ]
}
