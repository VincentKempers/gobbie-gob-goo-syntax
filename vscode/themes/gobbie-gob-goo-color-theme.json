    "peekViewResult.selectionBackground": "#373b41",
    "diffEditor.insertedTextBackground": "#9ed1a026",
    "diffEditor.removedTextBackground": "#fda1aa26",
    "diffEditor.insertedLineBackground": "#9ed1a014",
