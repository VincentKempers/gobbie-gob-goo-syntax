    "sideBarSectionHeader.foreground": "#c5c8c6",
    "sideBarSectionHeader.border": "#191e26",
    "list.activeSelectionBackground": "#373b41",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#373b41b3",
    "list.hoverBackground": "#373b4180",
    "list.focusOutline": "#a4d8d199",
    "list.highlightForeground": "#a4d8d1",
    "list.errorForeground": "#fda1aa",
    "list.warningForeground": "#f0c674",
    "tree.indentGuidesStroke": "#373b41",
    "editorGroup.border": "#191e26",
    "editorGroupHeader.tabsBackground": "#1f252f",
    "editorGroupHeader.tabsBorder": "#191e26",
    "tab.activeBackground": "#252c38",
    "tab.activeForeground": "#ffffff",
    "tab.activeBorderTop": "#fda1aa",
    "tab.inactiveBackground": "#1f252f",
    "tab.inactiveForeground": "#7f7f7f",
    "tab.border": "#191e26",
    "tab.hoverBackground": "#252c38",
    "tab.unfocusedActiveForeground": "#969896",
    "breadcrumb.foreground": "#7f7f7f",
    "breadcrumb.focusForeground": "#c5c8c6",
    "breadcrumb.background": "#252c38",
    "titleBar.activeBackground": "#1b2029",
    "titleBar.activeForeground": "#c5c8c6",
    "titleBar.inactiveBackground": "#1b2029",
    "titleBar.inactiveForeground": "#7f7f7f",
    "titleBar.border": "#191e26",
    "statusBar.background": "#1b2029",
    "statusBar.foreground": "#969896",
    "statusBar.border": "#191e26",
    "statusBar.debuggingBackground": "#f0c674",
    "statusBar.debuggingForeground": "#252c38",
    "statusBar.noFolderBackground": "#1b2029",
    "statusBarItem.remoteBackground": "#fda1aa",
    "statusBarItem.remoteForeground": "#252c38",
    "statusBarItem.hoverBackground": "#373b41",
    "panel.background": "#1f252f",
    "panel.border": "#191e26",
    "panelTitle.activeBorder": "#fda1aa",
    "panelTitle.activeForeground": "#c5c8c6",
    "panelTitle.inactiveForeground": "#7f7f7f",
    "terminal.background": "#1f252f",
    "terminal.foreground": "#c5c8c6",
    "terminalCursor.foreground": "#ffffff",
    "terminal.selectionBackground": "#4c4f57",
    "terminal.ansiBlack": "#282a2e",
    "terminal.ansiRed": "#fda1aa",
    "terminal.ansiGreen": "#9ed1a0",
    "terminal.ansiYellow": "#f0c674",
    "terminal.ansiBlue": "#81a2be",
    "terminal.ansiMagenta": "#d7a8d8",
    "terminal.ansiCyan": "#a4d8d1",
    "terminal.ansiWhite": "#c5c8c6",
    "terminal.ansiBrightBlack": "#7f7f7f",
    "terminal.ansiBrightRed": "#ffbfc5",
    "terminal.ansiBrightGreen": "#b9e3bb",
    "terminal.ansiBrightYellow": "#ffe2a1",
    "terminal.ansiBrightBlue": "#83c6d5",
    "terminal.ansiBrightMagenta": "#e8c6e9",
    "terminal.ansiBrightCyan": "#c3e8e3",
    "terminal.ansiBrightWhite": "#ffffff",
    "input.background": "#1b2029",
    "input.foreground": "#c5c8c6",
    "input.border": "#191e26",
    "input.placeholderForeground": "#7f7f7f",
    "inputOption.activeBorder": "#a4d8d1",
    "inputValidation.errorBorder": "#fda1aa",
    "inputValidation.warningBorder": "#f0c674",
    "inputValidation.infoBorder": "#81a2be",
    "dropdown.background": "#1b2029",
    "dropdown.border": "#191e26",
    "dropdown.foreground": "#c5c8c6",
    "button.background": "#a4d8d1",
    "button.foreground": "#252c38",
    "button.hoverBackground": "#83c6d5",
    "button.secondaryBackground": "#373b41",
    "button.secondaryForeground": "#c5c8c6",
    "badge.background": "#373b41",
    "badge.foreground": "#c5c8c6",
    "progressBar.background": "#a4d8d1",
    "scrollbar.shadow": "#00000033",
    "scrollbarSlider.background": "#373b4199",
    "scrollbarSlider.hoverBackground": "#373b41d9",
    "scrollbarSlider.activeBackground": "#373b41",
    "quickInput.background": "#1f252f",
    "quickInputList.focusBackground": "#373b41",
    "menu.background": "#1f252f",
    "menu.selectionBackground": "#373b41",
    "notifications.background": "#1f252f",
    "notifications.border": "#191e26",
    "gitDecoration.addedResourceForeground": "#9ed1a0",
    "gitDecoration.untrackedResourceForeground": "#9ed1a0",
    "gitDecoration.modifiedResourceForeground": "#f0c674",
    "gitDecoration.deletedResourceForeground": "#fda1aa",
    "gitDecoration.renamedResourceForeground": "#81a2be",
    "gitDecoration.ignoredResourceForeground": "#7f7f7f",
    "gitDecoration.conflictingResourceForeground": "#fda1aa"
